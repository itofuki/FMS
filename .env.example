# フロントエンド（Vite）用。コピーして .env.local を作成してください。
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions のシークレットは `supabase secrets set` で設定します（このファイルには書かない）:
#   SLACK_USER_TOKEN, SLACK_SIGNING_SECRET, GEMINI_API_KEY, GEMINI_MODEL(任意),
#   VAPID_SUBJECT, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
